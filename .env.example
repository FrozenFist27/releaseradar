# Copy to .env and fill in. NEVER commit the real .env.
# All values are placeholders only.

# --- LLM (optional filter; off unless filter.enabled=true in config) ---
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=

# --- GitHub (read-only; used for the Releases API) ---
GITHUB_TOKEN=

# --- Latency harness: sandbox repo + token that can publish releases ---
SANDBOX_REPO=
SANDBOX_GITHUB_TOKEN=

# --- Discord webhooks (alerts + health channels) ---
DISCORD_ALERTS_WEBHOOK_URL=
DISCORD_HEALTH_WEBHOOK_URL=

# --- Healthchecks.io dead-man switch (paste the ping URL, incl. the UUID) ---
HEALTHCHECKS_PING_URL=

# --- Runtime ---
RADAR_DB_PATH=data/radar.db
